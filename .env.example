# Local PostgreSQL development database (separate from any hosted Supabase data).
# Create the sjss_crm role/database first and replace CHANGE_ME with its password.
DATABASE_URL="postgresql://sjss_crm:CHANGE_ME@127.0.0.1:5433/sjss_crm?schema=public"
DIRECT_URL="postgresql://sjss_crm:CHANGE_ME@127.0.0.1:5433/sjss_crm?schema=public"

NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=""

# Administrator email codes are mandatory in production. Verify the sender
# domain with Resend, then set these privately. Never paste keys into chat.
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""
# Optional: also require email verification on the local development server.
# ADMIN_EMAIL_VERIFICATION="true"

# Production first administrator: set these securely before running db:seed.
# Password: at least 15 characters, at most 72 UTF-8 bytes. Never commit values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Explicit local demo data only; refused in production or against a remote DB.
# SEED_DEMO_DATA="true"

# Optional: enables AI extraction of quotation documents.
GEMINI_API_KEY=""

# Optional absolute directory on a persistent server disk (default: .local/uploads).
# UPLOAD_DIR="/absolute/private/uploads"

# Vercel: use private Supabase Storage instead of local disk. All keys below are
# server-only. Never prefix the secret key with NEXT_PUBLIC_. See DEPLOYMENT_GUIDE.md.
# FILE_STORAGE="supabase"
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_SECRET_KEY=""
# SUPABASE_STORAGE_BUCKET="crm-files"
# SUPABASE_UPLOAD_BUCKET="crm-pending"

# Local encrypted backups: defaults to .local/backup.key (created privately on
# first backup). Keep the key separately from copied backups; never commit it.
# BACKUP_KEY_FILE="/absolute/private/backup.key"
# Optional directory containing PostgreSQL 17 tools for backup/restore rehearsal.
# PG_BIN="/opt/homebrew/opt/postgresql@17/bin"
