{
  "name": "sjss-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx --ignore-path .gitignore",
    "db:push": "prisma db push",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test",
    "test:server": "node scripts/start-test-server.mjs",
    "db:migrate": "prisma migrate deploy",
    "files:migrate": "node scripts/migrate-private-files.mjs",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/check-deployment.mjs",
    "backup:create": "node scripts/local-backup.mjs create",
    "backup:verify": "node scripts/local-backup.mjs verify"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "4.9.0",
    "@types/multer": "^1.4.12",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "1.57.0",
    "multer": "^1.4.5-lts.1",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "npm run db:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "pdfjs-dist": "^6.4.299",
    "postcss": "8.5.30",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
